{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ddp",
      "destination": "/"
    },
    {
      "source": "/ddp/receive",
      "destination": "/receive"
    },
    {
      "source": "/exhibition",
      "destination": "/"
    },
    {
      "source": "/exhibition/receive",
      "destination": "/receive"
    }
  ]
}
